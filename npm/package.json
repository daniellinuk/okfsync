{
  "name": "okfsync",
  "version": "0.1.5",
  "description": "A concept wiki so your agents don't clobber the brain. CLI command: kbsync.",
  "homepage": "https://github.com/daniellinuk/okfsync",
  "bugs": {
    "url": "https://github.com/daniellinuk/okfsync/issues"
  },
  "license": "MIT",
  "bin": {
    "kbsync": "bin/kbsync.js"
  },
  "files": [
    "bin/",
    "lib/",
    "vendor/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node ./lib/install.js",
    "prepare-binary": "node ./scripts/prepare-binary.js",
    "pack-platforms": "node ./scripts/pack-platforms.js",
    "stamp-optional-deps": "node ./scripts/stamp-optional-deps.js",
    "check-vendor": "node ./scripts/check-vendor.js",
    "prepublishOnly": "node ./scripts/check-vendor.js",
    "test": "node --test ./lib/install.test.js ./lib/platforms.test.js ./scripts/pack-platforms.test.js ./scripts/assert-max-glibc.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniellinuk/okfsync.git",
    "directory": "npm"
  },
  "keywords": [
    "okfsync",
    "kbsync",
    "okf",
    "agents",
    "cli",
    "git"
  ],
  "optionalDependencies": {
    "okfsync-darwin-arm64": "0.1.5",
    "okfsync-darwin-x64": "0.1.5",
    "okfsync-linux-x64": "0.1.5",
    "okfsync-linux-arm64": "0.1.5",
    "okfsync-windows-x64": "0.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
