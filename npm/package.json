{
  "name": "okfsync",
  "version": "0.1.0",
  "description": "A concept wiki so your agents don't clobber the brain. Prebuilt binary wrapper for the okfsync CLI (`kbsync`).",
  "license": "MIT",
  "bin": {
    "kbsync": "bin/kbsync.js"
  },
  "files": [
